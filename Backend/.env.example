PORT=3000
NODE_ENV=development

# User and password must match POSTGRES_USER / POSTGRES_PASSWORD in the repo-root .env
# Production must be a TLS Postgres URL (sslmode=require) and must not use localhost
DATABASE_URL=postgres://hirevia:replace-with-a-local-password@localhost:5433/hirevia
# Production must include a password, for example rediss://:replace-with-redis-password@redis.internal:6379
REDIS_URL=redis://localhost:6379

# Production requires a unique value of at least 32 characters
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_GENAI_API_KEY=replace-with-your-gemini-api-key
# Optional. Default 45000. Small report calls should finish well under this.
# GEMINI_TIMEOUT_MS=45000

# Comma-separated browser origins. Production must be https:// and cannot be localhost
CLIENT_ORIGINS=http://localhost:5173

# Seeded super admin (upserted on backend start)
ADMIN_EMAIL=admin@hirevia.local
ADMIN_PASSWORD=replace-with-admin-password
ADMIN_USERNAME=admin

# Optional: set in Docker images (Chromium path)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
